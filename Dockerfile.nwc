FROM node:22-slim
ENV NODE_ENV=production
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY nwc-bridge.mjs .
# keys.json and nwc-uri.txt are written here. A named volume mounted at /data
# takes this ownership on first use, so the unprivileged user can write it.
RUN mkdir -p /data && chown node:node /data && chmod 700 /data
ENV DATA_DIR=/data
USER node
CMD ["node", "nwc-bridge.mjs"]
