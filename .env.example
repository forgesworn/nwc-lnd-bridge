# Copy to .env and fill in. NEVER commit the real file.
#
# The NWC capability lives in the data volume (keys.json, nwc-uri.txt), not
# here. Read the URI with: docker compose exec nwc-lnd-bridge cat /data/nwc-uri.txt
# LND_MACAROON authenticates to the node. For a funds-holding node, bake an INVOICE-ONLY
# macaroon and leave NWC_METHODS at its invoice-only default.
# One relay, or several separated by spaces/commas, e.g.
# NWC_RELAY="wss://relay.damus.io wss://nos.lol"
NWC_RELAY=wss://relay.damus.io

LND_REST_URL=https://127.0.0.1:8080
# hex-encode the macaroon:  xxd -p -c 2000 invoice.macaroon | tr -d '\n'
LND_MACAROON=
# base64 of tls.cert:  base64 -w0 tls.cert
# Required unless LND_REST_URL is loopback. To skip verification on a network
# you trust (the macaroon crosses it in every request), set LND_TLS_INSECURE=1.
LND_CERT=
LND_TLS_INSECURE=
# blank = make_invoice lookup_invoice list_transactions get_info (invoice-only).
# To allow spending / balance disclosure, list methods explicitly, e.g.:
#   NWC_METHODS="make_invoice lookup_invoice pay_invoice get_balance get_info"
NWC_METHODS=
# Required when pay_invoice is enabled, in millisatoshis. MAX_PAY_MSAT caps each
# payment; FEE_LIMIT_MSAT caps the routing fee LND may spend on it. There is no
# daily or total budget: fund the node with no more than the URI may lose.
MAX_PAY_MSAT=
FEE_LIMIT_MSAT=
